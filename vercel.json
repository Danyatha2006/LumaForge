{
  "functions": {
    "api/index.py": {
      "includeFiles": "{lumaforge/**,models/**,samples/**,results/summary.json}",
      "excludeFiles": "{.next/**,node_modules/**,public/**,docs/**,data/**,checkpoints/**,.venv/**,scripts/**,tests/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index" }]
}
